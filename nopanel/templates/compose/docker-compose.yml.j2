# noPanel v2 — Generated docker-compose.yml for service containers
# DO NOT MODIFY THIS FILE! YOUR CHANGES WILL BE LOST!
# Regenerated by: nopanel commit

services:
  # --- Apache (web) ---
  apache:
    image: {{ services.web.image }}
    container_name: nopanel-apache
    restart: unless-stopped
    network_mode: {{ network_mode }}
    # Use generated httpd.conf as the main config (mounted at conf.d/)
    command: ["httpd", "-f", "/usr/local/apache2/conf.d/httpd.conf", "-DFOREGROUND"]
{% if network_mode == "bridge" %}
    ports:
      - "80:80"
      - "443:443"
    depends_on:
{% for version in php_versions %}
      - php-{{ version }}
{% endfor %}
{% endif %}
    volumes:
{% for vol in apache_volumes %}
      - {{ vol }}
{% endfor %}
    healthcheck:
      test: ["CMD", "httpd", "-t", "-f", "/usr/local/apache2/conf.d/httpd.conf"]
      interval: 30s
      timeout: 5s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # --- PHP-FPM (one container per version) ---
{% for version in php_versions %}
  php-{{ version }}:
    image: {{ services.php[version]["image"] or "nopanel/php-" ~ version ~ ":latest" }}
    container_name: nopanel-php-{{ version }}
    restart: unless-stopped
    network_mode: {{ network_mode }}
{% if network_mode == "bridge" and services.mariadb["enabled"] %}
    depends_on:
      - mariadb
{% endif %}
    volumes:
{% for vol in php_volumes %}
      - {{ vol }}
{% endfor %}
    healthcheck:
      test: ["CMD", "php-fpm", "-t"]
      interval: 30s
      timeout: 5s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{% endfor %}

{% if services.mariadb["enabled"] %}
  # --- MariaDB ---
  mariadb:
    image: {{ services.mariadb.image }}
    container_name: nopanel-mariadb
    restart: unless-stopped
    network_mode: {{ network_mode }}
{% if network_mode == "bridge" %}
    ports:
      - "{{ services.mariadb.port }}:3306"
{% endif %}
    env_file:
      - mariadb.env
    volumes:
{% for vol in mariadb_volumes %}
      - {{ vol }}
{% endfor %}
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 30s
      timeout: 10s
      retries: 5
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

{% endif %}
{% if services.valkey["enabled"] %}
  # --- Valkey ---
  valkey:
    image: {{ services.valkey.image }}
    container_name: nopanel-valkey
    restart: unless-stopped
    network_mode: {{ network_mode }}
{% if network_mode == "bridge" %}
    ports:
      - "{{ services.valkey.port }}:6379"
{% endif %}
    volumes:
{% for vol in valkey_volumes %}
      - {{ vol }}
{% endfor %}
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 30s
      timeout: 5s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{% endif %}
