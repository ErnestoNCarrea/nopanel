# noPanel v2 — Custom PHP-FPM Dockerfile for PHP {{ php_version }}
# Generated by nopanel. Do not edit manually.

FROM php:{{ php_version }}-fpm-alpine

# System dependencies for PHP extensions (gd, intl, zip, etc.)
RUN apk add --no-cache \
    libpng-dev \
    icu-dev \
    libzip-dev \
    oniguruma-dev

# Core extensions (built into PHP)
RUN docker-php-ext-install {{ core_extensions | join(" ") }}

# PECL extensions
{% for ext in pecl_extensions %}
RUN pecl install {{ ext }} && docker-php-ext-enable {{ ext }}
{% endfor %}

# OPcache tuning (loaded after the extension's default ini; last value wins)
RUN printf 'opcache.enable_file_override=1\nopcache.max_accelerated_files=40000\nopcache.memory_consumption=256\n' \
    > /usr/local/etc/php/conf.d/zz-opcache-tune.ini

# Set working directory
WORKDIR /var/www/html
